{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "latest_ai.json contract",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string" },
    "server": { "type": "object" },
    "environment": { "type": "object" },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "number" },
        "passed": { "type": "number" },
        "failed": { "type": "number" },
        "skipped": { "type": "number" },
        "durationMs": { "type": "number" }
      },
      "required": ["total", "passed", "failed", "skipped", "durationMs"]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string" },
          "durationMs": { "type": "number" }
        },
        "required": ["id", "status", "durationMs"]
      }
    }
  },
  "required": ["timestamp", "summary", "tests"]
}
